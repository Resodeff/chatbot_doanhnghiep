# Copy file này thành .env rồi sửa. Đổi model chỉ cần sửa OLLAMA_MODEL.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-sale:latest  

# Tham số sinh câu trả lời
TEMPERATURE=0.3
NUM_CTX=4096
MAX_TOKENS=400
KEEP_ALIVE=30m
TIMEOUT_SECONDS=120

# Giới hạn đầu vào (tránh prompt quá dài làm model 4B chạy chậm)
MAX_HISTORY_TURNS=6
MAX_PRODUCTS=8

# File system prompt (sửa nội dung tư vấn mà không cần đụng code)
SYSTEM_PROMPT_FILE=system_prompt.txt
